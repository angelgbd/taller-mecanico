
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum EstadoOrden {
  abierta
  en_proceso
  entregada
  cancelada
}

model Cliente {
  id        Int        @id @default(autoincrement())
  nombre    String
  telefono  String
  correo    String     @unique
  vehiculos Vehiculo[]
}

model Vehiculo {
  id        Int             @id @default(autoincrement())
  placa     String          @unique
  marca     String
  modelo    String
  anio      Int
  clienteId Int
  cliente   Cliente         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  ordenes   OrdenServicio[]
}

model OrdenServicio {
  id           Int         @id @default(autoincrement())
  descripcion  String      @db.Text
  fechaIngreso DateTime    @default(now()) @db.DateTime(3)
  estado       EstadoOrden @default(abierta)
  vehiculoId   Int
  vehiculo     Vehiculo    @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  refacciones  Refaccion[]
}

model Refaccion {
  id              Int           @id @default(autoincrement())
  nombre          String
  precio          Decimal       @db.Decimal(10, 2)
  ordenServicioId Int
  ordenServicio   OrdenServicio @relation(fields: [ordenServicioId], references: [id], onDelete: Restrict)
}
